{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://plateforme-marches-publics.ma/schemas/company_profile.schema.json",
  "title": "EntrepriseProfileMaroc",
  "description": "Schéma standardisé du profil entreprise candidate aux marchés publics marocains (conforme au Décret n° 2-22-431)",
  "type": "object",
  "required": [
    "id",
    "identification_administrative",
    "representant_legal",
    "coordonnees",
    "capacites_financieres",
    "moyens_humains",
    "moyens_materiels",
    "qualifications_et_certifications",
    "references_similaires",
    "preferences_veille_et_strategie"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Identifiant unique interne (UUID v4) de l'entreprise"
    },
    "identification_administrative": {
      "type": "object",
      "description": "Identité juridique et immatriculations officielles au Maroc",
      "required": ["raison_sociale", "forme_juridique", "ice", "identifiant_fiscal", "registre_commerce", "numero_patente", "numero_affiliation_cnss", "capital_social_mad"],
      "properties": {
        "raison_sociale": { "type": "string", "minLength": 2, "description": "Dénomination officielle de la société" },
        "nom_commercial": { "type": "string" },
        "forme_juridique": {
          "type": "string",
          "enum": ["SARL", "SARL_AU", "SA", "SAS", "SNC", "GROUPEMENT", "COOPERATIVE", "AUTO_ENTREPRENEUR"]
        },
        "ice": {
          "type": "string",
          "pattern": "^[0-9]{15}$",
          "description": "Identifiant Commun de l'Entreprise (15 chiffres obligatoires)"
        },
        "identifiant_fiscal": {
          "type": "string",
          "pattern": "^[0-9]{7,10}$",
          "description": "Identifiant Fiscal (IF) délivré par la DGI"
        },
        "registre_commerce": {
          "type": "object",
          "required": ["numero", "tribunal_ville"],
          "properties": {
            "numero": { "type": "string", "description": "Numéro d'immatriculation au RC" },
            "tribunal_ville": { "type": "string", "description": "Ville du Tribunal de Commerce de rattachement" }
          }
        },
        "numero_patente": { "type": "string", "description": "Numéro de taxe professionnelle / patente" },
        "numero_affiliation_cnss": {
          "type": "string",
          "pattern": "^[0-9]{7,10}$",
          "description": "Numéro d'affiliation à la CNSS"
        },
        "date_creation": { "type": "string", "format": "date", "description": "Date de constitution légale (YYYY-MM-DD)" },
        "capital_social_mad": { "type": "number", "minimum": 0, "description": "Capital social libéré en Dirhams marocains (MAD)" },
        "statut_pme": {
          "type": "boolean",
          "description": "Éligibilité au statut PME au sens de la réglementation marocaine (accès aux 20% réservés)"
        },
        "eligibilite_preference_nationale": {
          "type": "boolean",
          "description": "Droit au bénéfice du taux de préférence nationale de 15% (art. 147 du Décret 2-22-431)"
        }
      }
    },
    "representant_legal": {
      "type": "object",
      "description": "Personne physique habilitée à engager la société et signer l'acte d'engagement",
      "required": ["nom", "prenom", "cin", "qualite", "pouvoir_signataire"],
      "properties": {
        "nom": { "type": "string" },
        "prenom": { "type": "string" },
        "cin": {
          "type": "string",
          "pattern": "^[A-Z]{1,2}[0-9]{4,8}$",
          "description": "Numéro de Carte d'Identité Nationale (CIN)"
        },
        "nationalite": { "type": "string", "default": "Marocaine" },
        "qualite": { "type": "string", "description": "Ex: Gérant Unique, Président Directeur Général, Fondé de pouvoir" },
        "pouvoir_signataire": {
          "type": "string",
          "enum": ["STATUTS", "PROCURATION_NOTARIEE", "DELIBERATION_CONSEIL"],
          "description": "Fondement juridique du pouvoir de signature"
        },
        "email_notification": { "type": "string", "format": "email" },
        "telephone_mobile": { "type": "string", "pattern": "^(\\+212|0)[5-7][0-9]{8}$" }
      }
    },
    "coordonnees": {
      "type": "object",
      "required": ["adresse_siege", "ville", "code_postal", "region", "telephone_fixe", "email_officiel"],
      "properties": {
        "adresse_siege": { "type": "string" },
        "complement_adresse": { "type": "string" },
        "ville": { "type": "string" },
        "code_postal": { "type": "string", "pattern": "^[0-9]{5}$" },
        "region": {
          "type": "string",
          "enum": [
            "Tanger-Tétouan-Al Hoceïma",
            "L'Oriental",
            "Fès-Meknès",
            "Rabat-Salé-Kénitra",
            "Béni Mellal-Khénifra",
            "Casablanca-Settat",
            "Marrakech-Safi",
            "Drâa-Tafilalet",
            "Souss-Massa",
            "Guelmim-Oued Noun",
            "Laâyoune-Sakia El Hamra",
            "Dakhla-Oued Ed-Dahab"
          ]
        },
        "telephone_fixe": { "type": "string" },
        "email_officiel": { "type": "string", "format": "email" },
        "site_web": { "type": "string", "format": "uri" }
      }
    },
    "qualifications_et_certifications": {
      "type": "object",
      "required": ["certificats_btp", "agrements_etudes", "certifications_normes"],
      "properties": {
        "certificats_btp": {
          "type": "array",
          "description": "Qualifications et classifications ministérielles BTP (Ministère de l'Équipement)",
          "items": {
            "type": "object",
            "required": ["secteur", "classe", "categories", "numero_certificat", "date_expiration"],
            "properties": {
              "secteur": { "type": "string", "description": "Secteur d'activité officiel (ex: Secteur A, B, C, etc.)" },
              "libelle_secteur": { "type": "string" },
              "classe": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Classe 1 (la plus élevée) à 5" },
              "categories": { "type": "array", "items": { "type": "string" }, "description": "Ex: ['A.1', 'A.2', 'A.3']" },
              "numero_certificat": { "type": "string" },
              "date_delivrance": { "type": "string", "format": "date" },
              "date_expiration": { "type": "string", "format": "date" }
            }
          }
        },
        "agrements_etudes": {
          "type": "array",
          "description": "Agréments pour bureaux d'études et laboratoires",
          "items": {
            "type": "object",
            "required": ["domaine_code", "domaine_libelle", "numero_agrement", "date_expiration"],
            "properties": {
              "domaine_code": { "type": "string", "description": "Ex: D1, D2, D8..." },
              "domaine_libelle": { "type": "string" },
              "numero_agrement": { "type": "string" },
              "date_expiration": { "type": "string", "format": "date" }
            }
          }
        },
        "certifications_normes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["norme", "organisme_certificateur", "date_expiration"],
            "properties": {
              "norme": { "type": "string", "description": "Ex: ISO 9001:2015, ISO 27001:2022, ISO 14001:2015, ISO 45001:2018" },
              "organisme_certificateur": { "type": "string", "description": "Ex: IMANOR, Bureau Veritas, SGS, AFNOR" },
              "numero_certificat": { "type": "string" },
              "date_expiration": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "capacites_financieres": {
      "type": "object",
      "required": ["bilans_3_derniers_exercices", "chiffre_affaires_moyen_3_ans_mad", "lignes_bancaires_caution"],
      "properties": {
        "bilans_3_derniers_exercices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["exercice_annee", "chiffre_affaires_global_mad", "chiffre_affaires_secteur_mad", "resultat_net_mad", "capitaux_propres_mad"],
            "properties": {
              "exercice_annee": { "type": "integer", "minimum": 2018, "maximum": 2030 },
              "chiffre_affaires_global_mad": { "type": "number", "minimum": 0 },
              "chiffre_affaires_secteur_mad": { "type": "number", "minimum": 0 },
              "resultat_net_mad": { "type": "number" },
              "capitaux_propres_mad": { "type": "number" },
              "tresorerie_nette_mad": { "type": "number" },
              "certifie_par_commissaire_aux_comptes": { "type": "boolean", "default": true }
            }
          }
        },
        "chiffre_affaires_moyen_3_ans_mad": {
          "type": "number",
          "minimum": 0,
          "description": "Moyenne arithmétique du chiffre d'affaires sur les 3 derniers exercices clos (exigé dans les RC)"
        },
        "lignes_bancaires_caution": {
          "type": "array",
          "description": "Lignes de crédit de cautionnement disponibles auprès des établissements bancaires agréés au Maroc",
          "items": {
            "type": "object",
            "required": ["banque", "agence", "plafond_caution_mad", "encours_disponible_mad"],
            "properties": {
              "banque": {
                "type": "string",
                "enum": ["Attijariwafa bank", "Banque Populaire", "Bank of Africa (BMCE)", "Société Générale Maroc", "BMCI", "Crédit du Maroc", "CIH Bank", "Autre"]
              },
              "agence": { "type": "string" },
              "plafond_caution_mad": { "type": "number", "minimum": 0 },
              "encours_disponible_mad": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "moyens_humains": {
      "type": "object",
      "required": ["effectif_total_declare_cnss", "personnel_cle_experts"],
      "properties": {
        "effectif_total_declare_cnss": { "type": "integer", "minimum": 1 },
        "cadres_et_ingenieurs": { "type": "integer", "minimum": 0 },
        "techniciens_et_agents_maitrise": { "type": "integer", "minimum": 0 },
        "ouvriers_et_employes": { "type": "integer", "minimum": 0 },
        "personnel_cle_experts": {
          "type": "array",
          "description": "CVs et fiches des profils clés pour le mémoire technique et l'offre technique",
          "items": {
            "type": "object",
            "required": ["id", "nom_complet", "cin", "role_titre", "niveau_etudes", "diplome", "annees_experience_totale", "annees_experience_specifique", "competences_cles"],
            "properties": {
              "id": { "type": "string" },
              "nom_complet": { "type": "string" },
              "cin": { "type": "string" },
              "role_titre": { "type": "string", "description": "Ex: Directeur de projet, Chef de mission BTP, Architecte Cloud Senior" },
              "niveau_etudes": { "type": "string", "enum": ["BAC+2", "BAC+3", "BAC+5_INGENIEUR", "BAC+5_MASTER", "DOCTORAT"] },
              "diplome": { "type": "string" },
              "ecole_universite": { "type": "string" },
              "annees_experience_totale": { "type": "number", "minimum": 0 },
              "annees_experience_specifique": { "type": "number", "minimum": 0 },
              "competences_cles": { "type": "array", "items": { "type": "string" } },
              "date_immatriculation_cnss": { "type": "string", "format": "date" },
              "resume_cv": { "type": "string", "description": "Texte synthétique prêt pour injection RAG dans le mémoire technique" }
            }
          }
        }
      }
    },
    "moyens_materiels": {
      "type": "object",
      "required": ["parc_materiel"],
      "properties": {
        "parc_materiel": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "designation", "categorie", "marque_modele", "annee_acquisition", "statut_possession"],
            "properties": {
              "id": { "type": "string" },
              "designation": { "type": "string" },
              "categorie": {
                "type": "string",
                "enum": ["ENGIN_CHANTIER", "VEHICULE_UTILITAIRE", "SERVEUR_DATA_CENTER", "MATERIEL_MESURE_LABO", "POSTE_TRAVAIL_INFORMATIQUE", "LICENCE_LOGICIEL_SPECIALISE", "AUTRE"]
              },
              "marque_modele": { "type": "string" },
              "immatriculation_ou_numero_serie": { "type": "string" },
              "annee_acquisition": { "type": "integer" },
              "statut_possession": { "type": "string", "enum": ["PLEINE_PROPRIETE", "CREDIT_BAIL_LEASING", "LOCATION_LONGUE_DUREE"] },
              "etat_fonctionnel": { "type": "string", "enum": ["EXCELLENT", "BON", "MOYEN"] }
            }
          }
        }
      }
    },
    "references_similaires": {
      "type": "array",
      "description": "Historique des marchés et projets déjà exécutés (utilisé pour les notes de références techniques)",
      "items": {
        "type": "object",
        "required": ["id", "client_nom", "client_type", "intitule_projet", "montant_marche_mad", "annee_debut", "annee_fin", "attestation_bonne_fin_disponible"],
        "properties": {
          "id": { "type": "string" },
          "client_nom": { "type": "string", "description": "Maître d'ouvrage (ex: OCP, Ministère de l'Intérieur, Commune de Rabat)" },
          "client_type": { "type": "string", "enum": ["PUBLIC", "SEMI_PUBLIC", "PRIVE"] },
          "numero_marche": { "type": "string", "description": "N° d'enregistrement officiel du marché s'il s'agit d'un marché public" },
          "intitule_projet": { "type": "string" },
          "description_prestations": { "type": "string" },
          "secteur_nomenclature": { "type": "string", "description": "Code ou intitulé du secteur au sens de la nomenclature marocaine" },
          "montant_marche_mad": { "type": "number", "minimum": 0 },
          "part_realisee_pourcentage": { "type": "number", "minimum": 1, "maximum": 100, "default": 100 },
          "annee_debut": { "type": "integer" },
          "annee_fin": { "type": "integer" },
          "attestation_bonne_fin_disponible": { "type": "boolean" },
          "signataire_attestation": { "type": "string" },
          "mots_cles_techniques": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "preferences_veille_et_strategie": {
      "type": "object",
      "description": "Critères de configuration des alertes du Module A et filtres Go/No-Go du Module B2",
      "required": ["domaines_cibles", "regions_cibles", "montant_min_souhaite_mad", "montant_max_souhaite_mad", "taux_marge_cible_pourcentage"],
      "properties": {
        "domaines_cibles": { "type": "array", "items": { "type": "string" } },
        "regions_cibles": { "type": "array", "items": { "type": "string" } },
        "types_marches_exclus": { "type": "array", "items": { "type": "string" } },
        "montant_min_souhaite_mad": { "type": "number", "minimum": 0 },
        "montant_max_souhaite_mad": { "type": "number", "minimum": 0 },
        "taux_marge_cible_pourcentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "tolerance_risque_financier": { "type": "string", "enum": ["FAIBLE", "MOYENNE", "ELEVEE"], "default": "MOYENNE" },
        "canaux_alertes": {
          "type": "object",
          "properties": {
            "email": { "type": "boolean", "default": true },
            "telegram": { "type": "boolean", "default": false },
            "whatsapp": { "type": "boolean", "default": true }
          }
        }
      }
    }
  }
}
