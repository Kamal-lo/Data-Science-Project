# ==============================================================================
# Configuration P3 — Module C (RAG & Gabarits Mémoire Technique : T40, T41, T42)
# ==============================================================================

# --- Qdrant Vector Store ---
# Modes supportés : remote | memory | local
QDRANT_MODE=remote
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=entreprise_corpus

# --- Embeddings multilingues (FR / AR) ---
# Utiliser 'sentence_transformer' en production (intfloat/multilingual-e5-base)
# ou 'hash' pour un démarrage instantané sans téléchargement de poids HF.
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768

# --- Chunking (T40) ---
DEFAULT_CHUNK_STRATEGY=recursive_structure
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120

# --- Reclassement (T41) ---
# 'hybrid' (rapide lexical+sémantique) ou 'cross_encoder'
RERANKER_PROVIDER=hybrid
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
DEFAULT_INITIAL_TOP_K=20
DEFAULT_FINAL_TOP_K=6
